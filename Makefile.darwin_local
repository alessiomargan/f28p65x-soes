CCS_CLI ?= $(CCS_INSTALL_DIR)/ccs/ccs-server.app/Contents/MacOS/ccs-server-cli.sh
# Adjust DSLITE to the installed UniFlash location on this host.
DSLITE ?= /Applications/ti/uniflash_9.6.0/dslite.sh
